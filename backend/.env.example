# AcePrep Backend Environment Configuration Example

# Server Configuration
PORT=5001
NODE_ENV=production

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aceprep?retryWrites=true&w=majority

# JWT Token Security (Generate random 64-char hex strings)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# CORS & Frontend Origin
FRONTEND_URL=https://your-frontend-domain.com

# Groq AI SDK Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Transactional Email Service (Brevo / Sendinblue)
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=AcePrep
