{
    "routes": [
        { "handle": "filesystem" },
        { "src": "/", "dest": "/index.html" },
        { "src": "/features", "dest": "/index.html" },
        { "src": "/about", "dest": "/index.html" },
        { "src": "/contact", "dest": "/index.html" },
        { "src": "/privacy", "dest": "/index.html" },
        { "src": "/privacy-policy", "dest": "/index.html" },
        { "src": "/login", "dest": "/index.html" },
        { "src": "/register", "dest": "/index.html" },
        { "src": "/dashboard", "dest": "/index.html" },
        { "src": "/start-interview", "dest": "/index.html" },
        { "src": "/start-video-interview", "dest": "/index.html" },
        { "src": "/resume-upload", "dest": "/index.html" },
        { "src": "/interview/[^/]+", "dest": "/index.html" },
        { "src": "/video-interview/[^/]+", "dest": "/index.html" },
        { "src": "/result/[^/]+", "dest": "/index.html" },
        { "src": "/history", "dest": "/index.html" },
        { "src": "/forgot-password", "dest": "/index.html" },
        { "src": "/reset-password/[^/]+", "dest": "/index.html" },
        { "src": "/(.*)", "dest": "/index.html", "status": 404 }
    ]
}